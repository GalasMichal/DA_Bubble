# Kopie: .env.deploy.local (liegt in .gitignore — nie committen)
# Haupt-FTP aus KAS (Tools → FTP), nicht Zusatzuser — dann alle Subdomain-Ordner.

FTP_SERVER=w01xxxx.kasserver.com
FTP_USERNAME=
FTP_PASSWORD=
