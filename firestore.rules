rules_version = '2';

// Demo (Portfolio): eingeloggte Clients inkl. anonymer Gast-Login.
// Strenger als „alles offen“, aber für DA_Bubble ohne Reibung nutzbar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
